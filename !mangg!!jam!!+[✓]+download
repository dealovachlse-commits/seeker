-- ==================== PANEL TOGGLE ====================
local currentPanel = nil

local function togglePanel(btn, panel)
    playClick()
    if currentPanel == panel then
        TweenService:Create(blur,TweenInfo.new(0.5),{Size=0}):Play()
        local pos = btn.AbsolutePosition
        TweenService:Create(panel,TweenInfo.new(1,Enum.EasingStyle.Elastic,Enum.EasingDirection.Out),{
            Size = UDim2.new(0,40,0,40),
            Position = UDim2.fromOffset(pos.X+20,pos.Y+54)
        }):Play()
        task.wait(1)
        panel.Visible = false
        currentPanel = nil
    else
        if currentPanel then currentPanel.Visible = false end
        currentPanel = panel
        local pos = btn.AbsolutePosition
        panel.Position = UDim2.fromOffset(pos.X+20,pos.Y+54)
        panel.Size = UDim2.new(0,40,0,40)
        panel.Visible = true
        TweenService:Create(blur,TweenInfo.new(0.5),{Size=12}):Play()  -- A little dark
        TweenService:Create(panel,TweenInfo.new(1,Enum.EasingStyle.Elastic,Enum.EasingDirection.Out),{
            Size = UDim2.new(0,222,0,223),
            Position = UDim2.new(0.5,-111,0.5,-111)
        }):Play()
    end
end

